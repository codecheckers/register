  "itemReviewed": {
    "@type": "ScholarlyArticle",
    "name": "Report 23: State-level tracking of COVID-19 in the United States version 2 (28-05-2020)\n",
    "author": [
      {
        "@type": "Person",
        "name": "H Juliette T Unwin",
        "@id": "https://orcid.org/0000-0002-9120-4003"
      },
      {
        "@type": "Person",
        "name": "Swapnil Mistra"
      },
      {
        "@type": "Person",
        "name": "Valerie C Bradley"
      },
