    "@type": "ScholarlyArticle",
    "name": "Generalizability of Foundation Models: A Case Study on Cocoa Mapping Across Countries Using Sparse Labels",
    "author": [
      {
        "@type": "Person",
        "name": "Ruslan Mammadov",
        "@id": "https://orcid.org/0009-0006-3516-9852"
      },
