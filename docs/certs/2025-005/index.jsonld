    "@type": "ScholarlyArticle",
    "name": "Verification Report of Zhao et al. (2023) ‘Effect of Acceptance and Commitment Therapy for depressive disorders: a meta-analysis’ \n",
    "author": [
      {
        "@type": "Person",
        "name": "Ian Hussey",
        "@id": "https://orcid.org/0000-0001-8906-7559"
