  "itemReviewed": {
    "@type": "ScholarlyArticle",
    "name": "Beyond colour gamuts: Novel metrics for the reproduction of photoreceptor signals",
    "author": [
      {
        "@type": "Person",
        "name": "A. C. Hexley",
        "@id": "https://orcid.org/0000-0002-0173-540X"
      },
      {
        "@type": "Person",
        "name": "T. Morimoto",
        "@id": "https://orcid.org/0000-0001-9897-8338"
      },
      {
        "@type": "Person",
