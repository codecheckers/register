  "itemReviewed": {
    "@type": "ScholarlyArticle",
    "name": "Flow Field Analysis of a Leading-Edge Inflatable Kite Rigid Scale Model Using Stereoscopic Particle Image Velocimetry",
    "author": [
      {
        "@type": "Person",
        "name": "Jelle Poland",
        "@id": "https://orcid.org/0000-0003-3164-5648"
      },
      {
        "@type": "Person",
        "name": "Erik Fritz",
        "@id": "https://orcid.org/0000-0003-1486-3643"
