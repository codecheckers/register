  "itemReviewed": {
    "@type": "ScholarlyArticle",
    "name": "Can we achieve significant climate mitigation by optimising only for contrails?",
    "author": [
      {
        "@type": "Person",
        "name": "Jakob Smretschnig",
        "@id": "https://orcid.org/0009-0003-6446-3039"
      },
      {
        "@type": "Person",
        "name": "Feijia Yin",
        "@id": "https://orcid.org/0000-0002-6081-9136"
      },
      {
