  "itemReviewed": {
    "@type": "ScholarlyArticle",
    "name": "How close is \"close\"? An analysis of the spatial characteristics of perceived proximity using Large Language Models",
    "author": [
      {
        "@type": "Person",
        "name": "Joseph Shingleton",
        "@id": "https://orcid.org/0000-0002-1628-3231"
      },
