  "itemReviewed": {
    "@type": "ScholarlyArticle",
    "name": "Optimal Graph Stretching for Distributed Averaging",
    "author": [
      {
        "@type": "Person",
        "name": "Florine W. Dekker",
        "@id": "https://orcid.org/0000-0002-0506-7365"
      },
      {
        "@type": "Person",
        "name": "Zekeriya Erkin",
        "@id": "https://orcid.org/0000-0001-8932-4703"
