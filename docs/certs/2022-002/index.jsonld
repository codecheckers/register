  "itemReviewed": {
    "@type": "ScholarlyArticle",
    "name": "Understanding the Imperfection of 3D point Cloud and Semantic Segmentation algorithms for 3D Models of Indoor Environment",
    "author": [
      {
        "@type": "Person",
        "name": "Guoray Cai orcid 1 and",
