    "name": "Analysis of the spatial and temporal pattern of COVID-19 incidence rate across Germany",
    "author": [
      {
        "@type": "Person",
        "name": "Sven Lautenbach",
        "@id": "https://orcid.org/0000-0003-1825-9996"
