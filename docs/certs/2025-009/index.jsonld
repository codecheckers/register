    "@type": "ScholarlyArticle",
    "name": "Mobility Vitality in Active and Micro-Mobility Modes: Measuring Urban Vitality Through Spatiotemporal Similarity",
    "author": [
      {
        "@type": "Person",
        "name": "Dan Qiang",
        "@id": "https://orcid.org/0000-0002-7483-2681"
