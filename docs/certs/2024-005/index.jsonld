  "itemReviewed": {
    "@type": "ScholarlyArticle",
    "name": "Sample size estimation for task-related functional MRI studies using Bayesian updating.",
    "author": [
      {
        "@type": "Person",
        "name": "Eduard Klapwijk",
        "@id": "https://orcid.org/0000-0002-8936-0365"
      },
      {
        "@type": "Person",
        "name": "Joran Jongerling",
        "@id": "https://orcid.org/0000-0001-5697-1381"
      },
      {
