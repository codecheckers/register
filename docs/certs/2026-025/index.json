  "paper": {
    "title": "Constructing melanopic light exposure profiles from sparse daily-route measurements",
    "authors": [
      {
        "name": "Niloufar Tabandeh",
        "orcid": "0000-0002-7971-8589"
      },
      {
        "name": "Jennifer A. Veitch",
        "orcid": "0000-0003-3183-4537"
      },
