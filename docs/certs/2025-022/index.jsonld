  "itemReviewed": {
    "@type": "ScholarlyArticle",
    "name": "Reinforcement Learning With Model Predictive Control for Highway Ramp Metering",
    "author": [
      {
        "@type": "Person",
        "name": "Filippo Airaldi",
        "@id": "https://orcid.org/0000-0001-6595-2932"
      },
      {
        "@type": "Person",
        "name": "Bart De Schutter",
        "@id": "https://orcid.org/0000-0001-9867-6196"
