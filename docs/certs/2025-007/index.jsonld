  "itemReviewed": {
    "@type": "ScholarlyArticle",
    "name": "Wind Tunnel Load Measurements of a Leading-Edge Inflatable Kite Rigid Scale Model",
    "author": [
      {
        "@type": "Person",
        "name": "Jelle Agatho Wilhelm Poland",
        "@id": "https://orcid.org/0000-0003-3164-5648"
      },
      {
        "@type": "Person",
        "name": "Johannes Marinus van Spronsen"
      },
