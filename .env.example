# Local configuration for the register Makefile targets.
#
# Copy this file to ".env" and fill in the values. ".env" is git-ignored, so
# the keys stay on your machine. The Makefile includes it and exports the
# variables to the R processes it starts, so no target needs the key passed in
# by hand. A single value can still be overridden per invocation:
#
#   make render OPENALEX_API_KEY=abc123
#
# Note that a ".Renviron" in this directory would NOT work for this: R reads
# only the first .Renviron it finds, so a local one shadows ~/.Renviron and
# GITHUB_PAT and ORCID_TOKEN set there would be lost. Keep those in
# ~/.Renviron, and put register specific keys here.

# OpenAlex API key, used to look up OpenAlex IDs and abstracts for papers.
# Without a key all requests share a small anonymous daily quota that a single
# full render exhausts, after which certificates render without their OpenAlex
# ID. A free key raises the quota tenfold, get one at https://openalex.org/ and
# see https://help.openalex.org/api for the details.
OPENALEX_API_KEY=

# Zenodo personal access token, used by the "zenodo_check" and "zenodo_curate"
# targets to audit and correct published certificate records against the
# CODECHECK community curation policy,
# https://zenodo.org/communities/codecheck/curation-policy
# Only "make zenodo_curate CERT_ID=... APPLY=1" needs it; the audit is
# read-only and works without a token. Create one at
# https://zenodo.org/account/settings/applications/ with the scopes
# "deposit:write" and "deposit:actions".
ZENODO_TOKEN=

# OSF personal access token, used to read the codecheck.yml files of the 60+
# certificates archived on OSF. Anonymous requests share a small quota per IP
# that a full render exhausts - OSF's file server then answers "Forbidden
# (HTTP 403)" and the affected certificates render without their metadata.
# Create a read-only token at https://osf.io/settings/tokens (scope
# "osf.full_read").
OSF_PAT=
